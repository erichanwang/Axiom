# Compute-heavy workload for benchmark.sh: deep recursion plus a tight
# arithmetic loop. Lives outside the repo root so run_tests.sh's *.lang glob
# does not pull a multi-second program into the correctness suite.

func fib(n) {
  if (n < 2) {
    return n
  }
  return fib(n - 1) + fib(n - 2)
}

prt fib(21)

func is_prime(n) {
  if (n < 2) {
    return 0
  }
  d = 2
  while (d * d <= n) {
    if (n % d == 0) {
      return 0
    }
    d = d + 1
  }
  return 1
}

count = 0
i = 2
while (i <= 4000) {
  if (is_prime(i)) {
    count = count + 1
  }
  i = i + 1
}
prt count
