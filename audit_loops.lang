func nested(limit) {
  i = 0
  total = 0
  while (i < limit) {
    i = i + 1
    if (i == 2) {
      continue
    }
    j = 0
    while (j < 4) {
      j = j + 1
      if (j == 2) {
        continue
      }
      k = 0
      while (k < 4) {
        k = k + 1
        if (k == 3) {
          break
        }
        total = total + 1
      }
      if (j == 3) {
        break
      }
    }
    if (i == 4) {
      break
    }
  }
  return total
}

prt nested(6)
