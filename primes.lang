# Trial-division primes: a function called from inside a nested loop.
func is_prime(n) {
  if (n < 2) {
    return 0
  }
  d = 2
  while (d * d <= n) {
    if (n % d == 0) {
      return 0
    }
    d = d + 1
  }
  return 1
}

count = 0
i = 2
while (i <= 50) {
  if (is_prime(i)) {
    prt i
    count = count + 1
  }
  i = i + 1
}
prt "primes found:"
prt count
