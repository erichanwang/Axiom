# Further edge cases beyond edge_cases.lang / array_edge_cases.lang: places
# where the three backends (interpreter, vm, x86-64) are most likely to
# diverge because each re-derives the same semantics independently.

# Modulo and division with negative operands. fmod's sign follows the
# dividend in C/C++, and all three backends must agree on that, not on
# mathematical (always-nonnegative) modulo.
prt -7 % 3
prt 7 % -3
prt -7 % -3
prt -7 / 3
prt 7 / -2
prt -7 / -2

# Division/modulo by zero with a negative dividend still has to hit the
# error path, not silently produce -inf/NaN.
prt -5 / 0
prt -5 % 0

# Deep recursion: exercises stack-frame handling under the codegen's
# %rbp-relative locals, the VM's call-frame vector, and the interpreter's
# native C++ call stack, all under the same depth.
func countdown(n) {
  if (n <= 0) {
    return 0
  }
  return 1 + countdown(n - 1)
}
prt countdown(2000)

# break/continue nested three loops deep: break/continue must only affect
# the innermost loop, not unwind further than that.
total = 0
i = 0
while (i < 4) {
  j = 0
  while (j < 4) {
    k = 0
    while (k < 4) {
      if (k == 2) {
        break
      }
      if (j == 1) {
        k = k + 1
        continue
      }
      total = total + 1
      k = k + 1
    }
    j = j + 1
  }
  i = i + 1
}
prt total

# continue in the outer loop while the inner loop has already run partway,
# checking that the inner loop's local re-initializes correctly each pass.
count = 0
a = 0
while (a < 5) {
  a = a + 1
  if (a == 3) {
    continue
  }
  b = 0
  while (b < 3) {
    if (b == 1) {
      b = b + 1
      continue
    }
    count = count + 1
    b = b + 1
  }
}
prt count

# Comparison "chains": the grammar has no real chained comparison, but
# and/or built from comparisons is the closest equivalent, and precedence
# between comparisons and and/or has to agree across all three backends.
x = 5
prt x > 0 and x < 10
prt x > 0 and x < 10 and x != 5
prt x < 0 or x > 100 or x == 5
prt 1 == 1 == 1
prt (1 == 1) == 1

# String/number coercion on '+', chained.
prt 1 + 2 + "x"
prt "x" + 1 + 2
prt 1 + "x" + 2
prt "" + 0
prt 0 + ""

# Large-magnitude arithmetic, where doubles stop being exact and where a
# naive integer-based codegen path would overflow silently.
big = 100000000
prt big * big
prt big * big * big
prt (big * big) % 7
prt -1 * big * big
